# --- 主程式 ---
async def main():
    load_config()
    loop = asyncio.get_running_loop()
    setup_mqtt_client(loop)
    setup_bill_acceptor()
    
    background_tasks = [
        system_info_task(), 
        mqtt_message_processor(), 
        qrcode_scanner_loop()
        # bill_acceptor_loop() # 如果需要，也應加入
    ]

    try:
        server = await websockets.serve(websocket_handler, "127.0.0.1", 8765)
        print(f"[OK] WebSocket 伺服器已啟動於 ws://127.0.0.1:8765")
        await asyncio.gather(*background_tasks)
    except Exception as e:
        print(f"[Fatal] 伺服器啟動失敗: {e}", file=sys.stderr)

if __name__ == "__main__":
    try:
        print("--- 儲值機後端服務啟動 ---")
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n--- 服務已手動關閉 ---")

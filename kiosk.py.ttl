#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# ==============================================================================
# Kiosk 後端服務 (整合序列埠掃描器 - 最終修正版)
# ==============================================================================

import asyncio
import json
from aiohttp import ClientSession
import websockets
import os
import sys
import paho.mqtt.client as mqtt
import psutil
import socket
import serial
import serial.tools.list_ports
import requests
import re
import time

# --- 全域變數 ---
CONNECTED_CLIENTS = set()
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
CONFIG = {}
mqtt_message_queue = asyncio.Queue()
bill_acceptor = None
BILL_ACCEPTOR_PORT = None
BILL_ACCEPTOR_ENABLED = False
SETTINGS_PATH = os.path.join(BASE_DIR, 'kiosk_settings.json')
LOG_FILE_PATH = "/home/maho/kiosk_session.log"
MAX_LOG_SIZE_MB = 10
DEVICE_LOCK_STATE = "0"

# --- CH340 序列埠設定 ---
CH340_VID = 0x1a86
CH340_PID = 0x7523
SERIAL_BAUDRATE = 9600

# --- 載入外部設定檔 ---
def load_config():
    global CONFIG
    config_path = os.path.join(BASE_DIR, 'config.json')
    try:
        with open(config_path, 'r', encoding='utf-8') as f:
            CONFIG = json.load(f)
        print("[Info] config.json 設定檔已成功載入。")
    except Exception as e:
        print(f"[Fatal] 讀取設定檔時發生錯誤: {e}", file=sys.stderr)
        sys.exit(1)

# --- API 相關函式 ---
def get_device_id():
    """從主機名稱中獲取最後四位數字作為 did"""
    try:
        hostname = socket.gethostname()
        match = re.search(r'(\d{4})$', hostname)
        if match:
            return match.group(1)
        else:
            print(f"⚠️ 警告: 無法從主機名稱 '{hostname}' 中找到結尾的四位數字。")
            return "0000"
    except Exception as e:
        print(f"❌ 獲取主機名稱時發生錯誤: {e}")
        return "0000"

def api_get_member_info(usn, pid, did):
    """(fn=info) 同步執行會員驗證 API 呼叫"""
    api_url = CONFIG.get("api_base_url")
    params = {'fn': 'info', 'usn': usn, 'pid': pid, 'did': did}
    try:
        response = requests.get(api_url, params=params, timeout=10)
        return response.json() if response.status_code == 200 else {"success": False, "message": f"API 錯誤 (Code: {response.status_code})"}
    except requests.exceptions.RequestException as e:
        print(f"[API] 網路請求時發生錯誤: {e}")
        return {"success": False, "message": "網路連線失敗"}

def api_recharge(usn, pid, did, amount):
    """(fn=recharge) 同步執行點數儲值 API 呼叫"""
    api_url = CONFIG.get("api_base_url")
    params = {'fn': 'recharge', 'usn': usn, 'pid': pid, 'did': did, 'recharge': amount}
    try:
        response = requests.get(api_url, params=params, timeout=10)
        return response.json() if response.status_code == 200 else {"success": False, "message": f"API 錯誤 (Code: {response.status_code})"}
    except requests.exceptions.RequestException as e:
        print(f"[API] 網路請求時發生錯誤: {e}")
        return {"success": False, "message": "網路連線失敗"}

def api_recharge_allow(usn, pid, transaction_id, did):
    """(fn=recharge_allow) 同步執行儲值權限查詢 API 呼叫"""
    api_url = CONFIG.get("api_base_url")
    params = {'fn': 'recharge_allow', 'usn': usn, 'pid': pid, 'id': transaction_id, 'did': did}
    try:
        response = requests.get(api_url, params=params, timeout=10)
        return response.json() if response.status_code == 200 else {"success": False, "message": f"API 錯誤 (Code: {response.status_code})"}
    except requests.exceptions.RequestException as e:
        print(f"[API] 網路請求時發生錯誤: {e}")
        return {"success": False, "message": "網路連線失敗"}

# --- QRCode 資料處理函式 (共用邏輯) ---
async def handle_qr_code_data(qr_string):
    """解析 QRCode 字串，驗證會員並廣播結果"""
    print(f"[QRCode] 正在處理資料: {qr_string}")
    try:
        qr_data = json.loads(qr_string)
        if qr_data.get("type") == "user" and qr_data.get("usn") and qr_data.get("pid"):
            usn, pid, did = qr_data.get("usn"), qr_data.get("pid"), get_device_id()
            loop = asyncio.get_running_loop()
            member_data = await loop.run_in_executor(None, api_get_member_info, usn, pid, did)
            
            if member_data and member_data.get("pld"):
                valid_data = member_data["pld"]
                valid_data.update({'usn': usn, 'pid': pid})
                await broadcast({"event": "member_info_valid", "data": valid_data})
            else:
                await broadcast({"event": "member_info_invalid", "message": member_data.get("message", "無效的會員資料")})
        else:
            await broadcast({"event": "member_info_invalid", "message": "無效的 QRCode 格式"})
    except (json.JSONDecodeError, TypeError):
        await broadcast({"event": "member_info_invalid", "message": "QRCode 解析失敗"})
    except Exception as e:
        print(f"[QRCode] 處理時發生未知錯誤: {e}")
        await broadcast({"event": "member_info_invalid", "message": "處理 QRCode 時發生錯誤"})

# --- WebSocket 核心邏輯 ---
async def websocket_handler(websocket):
    CONNECTED_CLIENTS.add(websocket)
    print(f"[Info] 瀏覽器已連接。")
    try:
        async for message in websocket:
            try:
                data = json.loads(message)
                action = data.get("action")
                loop = asyncio.get_running_loop()
                did = get_device_id()

                if action == "qrcode_scanned":
                    await handle_qr_code_data(json.dumps(data.get("data", {})))
                
                elif action == "deposit_complete":
                    disable_bill_acceptor()
                    await broadcast({"event": "deposit_finalized", "message": "儲值完成！感謝您的使用。"})

                elif action == "deposit_update":
                    deposit_data = data.get("data", {})
                    usn, pid, amount = deposit_data.get("usn"), deposit_data.get("pid"), deposit_data.get("total_amount")
                    if usn and pid and amount and amount > 0:
                        recharge_response = await loop.run_in_executor(None, api_recharge, usn, pid, did, amount)
                        transaction_id = recharge_response.get('pld', {}).get('id')
                        if transaction_id:
                            allow_response = await loop.run_in_executor(None, api_recharge_allow, usn, pid, transaction_id, did)
                            if not (allow_response and allow_response.get("pld")):
                                await broadcast({"event": "recharge_failed", "message": allow_response.get("message", "儲值驗證失敗")})
                        else:
                            await broadcast({"event": "recharge_failed", "message": "無法取得交易序號"})
                
                elif action == "get_initial_ads":
                    settings = {}
                    if os.path.exists(SETTINGS_PATH):
                        with open(SETTINGS_PATH, 'r', encoding='utf-8') as f:
                            settings = json.load(f)
                    
                    ad_list = []
                    for i in range(1, 6):
                        found = next((f for f in os.listdir(BASE_DIR) if f.startswith(str(i) + '.')), None)
                        if found:
                            ad_list.append({"file": found, "duration": settings.get("Durations", {}).get(str(i), 10)})
                    
                    await websocket.send(json.dumps({
                        "event": "initial_data", 
                        "ads": ad_list, 
                        "marqueeText": settings.get("MarqueeText", "歡迎光臨！")
                    }))
                
                elif action == "user_validated": 
                    enable_bill_acceptor()
                
                elif action == "get_device_lock_status":
                    await broadcast({"event": "device_shift_lock", "data": DEVICE_LOCK_STATE})

            except Exception as e:
                print(f"[Error] 處理 WebSocket 訊息時發生錯誤: {e}", file=sys.stderr)
    finally:
        CONNECTED_CLIENTS.remove(websocket)
        print("[Info] 一個瀏覽器已斷開連接。")

# --- 序列埠掃描器 (非阻塞修正版) ---
def find_ch340_port():
    ports = serial.tools.list_ports.comports()
    for port in ports:
        if port.vid == CH340_VID and port.pid == CH340_PID:
            print(f"[Hardware] 找到 CH340 QRCode 掃描器於: {port.device}")
            return port.device
    print("[Warning] 找不到 CH340 QRCode 掃描器。", file=sys.stderr)
    return None

async def qrcode_scanner_loop():
    """背景任務：持續監聽 CH340 序列埠的資料 (非阻塞版本)"""
    port_name = find_ch340_port()
    if not port_name:
        return

    loop = asyncio.get_running_loop()
    ser = None

    while True:
        try:
            if ser is None or not ser.is_open:
                print(f"[Scanner] 正在開啟序列埠 {port_name}...")
                ser = serial.Serial(
                    port=port_name,
                    baudrate=SERIAL_BAUDRATE,
                    timeout=1 
                )
                print(f"[Scanner] 序列埠 {port_name} 已開啟，開始監聽...")

            # 將阻塞的 ser.readline() 操作放到執行緒池中運行，避免阻塞事件迴圈
            line = await loop.run_in_executor(None, ser.readline)
            
            if line:
                try:
                    decoded_line = line.decode('utf-8').strip()
                    if decoded_line:
                        await handle_qr_code_data(decoded_line)
                except UnicodeDecodeError:
                    print(f"[Scanner] 收到無法解碼的資料: {line}")

        except serial.SerialException as e:
            print(f"[Scanner] 序列埠錯誤: {e}", file=sys.stderr)
            if ser and ser.is_open:
                ser.close()
            ser = None
            print("[Scanner] 5 秒後將嘗試重新連線...")
            await asyncio.sleep(5)
        except Exception as e:
            print(f"[Scanner] 監聽迴圈發生未知錯誤: {e}", file=sys.stderr)
            await asyncio.sleep(5)

# --- 其他背景任務 ---
async def broadcast(message_payload):
    if CONNECTED_CLIENTS:
        message_str = json.dumps(message_payload)
        # 使用 ensure_future 避免 await 卡住廣播
        tasks = [asyncio.ensure_future(client.send(message_str)) for client in CONNECTED_CLIENTS]
        await asyncio.gather(*tasks, return_exceptions=True)


async def system_info_task():
    while True:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("8.8.8.8", 80))
            ip = s.getsockname()[0]
            s.close()
        except Exception:
            ip = "N/A"
        try:
            with open("/sys/class/thermal/thermal_zone0/temp") as f:
                temp = f"{int(f.read().strip()) / 1000:.1f}"
        except Exception:
            temp = "N/A"
        
        info = {
            "ip": ip, "cpu_usage": psutil.cpu_percent(),
            "disk_usage": psutil.disk_usage('/').percent, "cpu_temp": temp,
            "device_id": CONFIG.get("kiosk_port")
        }
        await broadcast({"event": "system_info", "data": info})
        await asyncio.sleep(5)

# --- MQTT 客戶端邏輯 ---
def setup_mqtt_client(loop):
    client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
    client.user_data_set({'loop': loop})
    
    def on_connect(client, userdata, flags, rc, properties=None):
        if rc == 0:
            print("[MQTT] 成功連接到 Broker")
            hostname = socket.gethostname()
            status_topic = CONFIG.get("mqtt_topic_status", "kiosk/status")
            client.publish(status_topic, f"{hostname} online", qos=1, retain=True)
            
            topics = [
                (f"{CONFIG.get('mqtt_topic_ads', 'kiosk/ads/update')}/#", 0),
                (f"{CONFIG.get('mqtt_topic_marquee', 'kiosk/marquee/set')}/#", 0),
                (f"{CONFIG.get('mqtt_topic_notify', 'kiosk/system/notify')}/#", 0),
                (f"node/dealer/{CONFIG.get('dealer_sn')}/shift-locked", 0)
            ]
            client.subscribe(topics)
            print(f"[MQTT] 已訂閱主題: {[t[0] for t in topics]}")
        else:
            print(f"[Error] MQTT 連接失敗，返回碼: {rc}", file=sys.stderr)

    def on_message(client, userdata, msg):
        try:
            payload_str = msg.payload.decode("utf-8")
            loop.call_soon_threadsafe(mqtt_message_queue.put_nowait, (msg.topic, payload_str))
        except Exception as e:
            print(f"[Error] 處理 MQTT 訊息時發生錯誤: {e}", file=sys.stderr)

    client.on_connect = on_connect
    client.on_message = on_message
    
    hostname = socket.gethostname()
    status_topic = CONFIG.get("mqtt_topic_status", "kiosk/status")
    client.will_set(status_topic, f"{hostname} offline", qos=1, retain=True)
    
    if CONFIG.get("mqtt_user"):
        client.username_pw_set(CONFIG["mqtt_user"], CONFIG.get("mqtt_password"))
        
    try:
        client.connect(CONFIG.get("mqtt_broker"), CONFIG.get("mqtt_port", 1883), 60)
        client.loop_start()
    except Exception as e:
        print(f"[Error] 無法啟動 MQTT 客戶端: {e}", file=sys.stderr)
    return client

# --- 恢復的完整功能 ---
